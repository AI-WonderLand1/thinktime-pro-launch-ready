# Server runtime
# Cloud Run/most platforms provide PORT automatically. Local default is 3000.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:3000

# Reverse-proxy trust. Leave unset locally. Most single-hop hosted deployments can use 1.
# Set false when ThinkTime is directly exposed without a trusted proxy.
TRUST_PROXY=

# Firebase project used to validate browser Firebase ID tokens on the Express API.
FIREBASE_PROJECT_ID=fabled-emissary-09v0l

# Optional local-development fallback only. Production always requires BYOK.
GEMINI_API_KEY=

# Optional Firebase client overrides. The AI Studio Firebase project is the built-in default.
VITE_FIREBASE_PROJECT_ID=fabled-emissary-09v0l
VITE_FIREBASE_APP_ID=1:164223903788:web:3d364a63b3409c791b8989
VITE_FIREBASE_API_KEY=AIzaSyAdlxzOlDbDhuTOLvLQjZ86sI8h9GseO9A
VITE_FIREBASE_AUTH_DOMAIN=fabled-emissary-09v0l.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=fabled-emissary-09v0l.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=164223903788
VITE_FIREBASE_DATABASE_ID=ai-studio-thinktimepro-533f3657-be4e-4985-819e-a6f254e8d983
